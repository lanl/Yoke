#!/bin/bash

# Yoke single-process CPU training job for rocinante (ro_tpbf_mlp_meas: forward
# model with in-situ measurables as inputs).
# The harness uses HarnessTrainer(device_type="cpu").
# Generated by the yoke-slurm-template skill on 2026-11-13; machine profile:
# skills/yoke-slurm-template/machines/rocinante.md
# CPU-only nodes: 2x 56-core Xeon 8480+, 2 threads per core, ~237 GB.
# Partition, QOS, wall time, and the reservation option come from the study
# CSV. Smoke: debug partition + QOS, which requires --reservation=debug (open to
# child accounts of asc, e.g. xd). Production: standard, --reservation= (none).

#SBATCH --job-name=tpbfM_s<studyIDX>_e<epochIDX>
#SBATCH --account=<allocation>
#SBATCH --partition=<PARTITION>
#SBATCH --qos=<QOS>
#SBATCH --time=<WALLTIME>
#SBATCH <RESERVATION_OPT>
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=224
#SBATCH --output=study<studyIDX>_epoch<epochIDX>.out
#SBATCH --error=study<studyIDX>_epoch<epochIDX>.err

# Python environment with Yoke installed.
module load python/3.13.18
source /usr/projects/eada/users/hickmank/manufacturing/Yoke/.venv/bin/activate

# Training threads (torch reads this at start-up). A 17k-parameter MLP with
# batch 4 is fastest on few threads; check the epoch time in the smoke run.
export OMP_NUM_THREADS=4

export date00=`date`

# One process; the train script reads its arguments from the @-file.
python -u <train_script> @<INPUTFILE>

export date01=`date`
echo "===================TIME STARTED==================="
echo $date00
echo "===================TIME FINISHED==================="
echo $date01
